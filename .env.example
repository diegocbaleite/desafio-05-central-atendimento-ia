# Copiar para .env; nunca publicar chaves reais. Deixe vazio o que não for usar.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Preencha com um API Token Cloudflare com permissão para Workers AI; não use a Global API Key.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# OpenAI: necessária para os modelos padrão de texto, visão, áudio e imagem.
OPENAI_API_KEY=
