# Copiar para .env; nunca publicar chaves reais. Deixe vazio o que não for usar.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Preencha com um API Token Cloudflare com permissão para Workers AI; não use a Global API Key.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Desafio 6: opcional. Valor FICTÍCIO usado só para demonstrar que segredos não vazam
# (a avaliação integrada cria um canário aleatório em memória; não é preciso preencher).
SEGREDO_FICTICIO_DEMO=
