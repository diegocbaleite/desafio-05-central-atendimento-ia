{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag_resposta.v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "resposta", "afirmacoes", "divergencias"],
  "properties": {
    "status": {"enum": ["fundamentada", "sem_evidencia_suficiente", "conflito_de_fontes"]},
    "resposta": {"type": "string", "maxLength": 2000},
    "afirmacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["texto", "chunk_ids", "citacao_literal"],
        "properties": {
          "texto": {"type": "string", "minLength": 1},
          "chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "citacao_literal": {"type": "string", "minLength": 1}
        }
      }
    },
    "divergencias": {"type": "array", "items": {"type": "string"}}
  }
}
